{
  "compilerOptions": {
    "target": "ES2020",
    // ESM, not CommonJS. Companion's entrypoint loader does
    // `typeof moduleImport === 'function' ? moduleImport : moduleImport.default`
    // and requires the result to be the instance constructor. Emitting CJS made
    // the bundler wrap the module in an interop factory, so `default` came back
    // as the namespace object `{CoreVideoInstance, default}` rather than the
    // class, and Companion rejected the module with "Module entrypoint did not
    // return a valid constructor function" (2026-08-22). The sources already
    // use ESM-style explicit `.js` import specifiers, so this is what they were
    // always written for; package.json carries the matching "type": "module".
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
