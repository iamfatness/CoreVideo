// I420 -> RGB for the CoreVideo Tiles wall.
//
// BT.709, FULL range. This must match set_yuv_frame_color_info() in
// src/zoom-source.cpp, which passes VIDEO_CS_709 + VIDEO_RANGE_FULL with
// full_range = true. Full range means the luma is NOT rescaled from 16-235;
// applying a limited-range rescale here would wash every face out.

uniform float4x4 ViewProj;
uniform texture2d image;   // Y plane, GS_R8
uniform texture2d tex_u;   // U plane, GS_R8, half size
uniform texture2d tex_v;   // V plane, GS_R8, half size

// ── Tile border ──────────────────────────────────────────────────────────────
// All per-tile values. libobs uploads a pass's parameters inside
// gs_technique_begin_pass() (upload_parameters(), graphics/effect.c) and does
// not re-upload them for later draws, so every one of these must be set BEFORE
// that tile's begin_pass. The draw path funnels both the video and the neutral
// placeholder through tiles_begin_pass() for exactly that reason.
uniform float4 border_color;   // stroke colour; only .rgb is used
uniform float2 tile_size;      // the tile's width/height in canvas pixels
uniform float  border_width;   // canvas pixels; 0 = no border
uniform float  corner_radius;  // canvas pixels; 0 = square corners

// The sub-rectangle of the source texture this draw samples, in normalized
// texture coordinates: .xy = origin, .zw = size.
//
// This exists because vert_in.uv is NOT 0..1 across the tile. The video path
// draws with gs_draw_sprite_subregion(), which builds its quad's UVs as
// sub_x/tex_w .. (sub_x+sub_cx)/tex_w (build_subsprite_norm(),
// libobs/graphics/graphics.c:1002-1025) so that the cover-crop is sampled —
// so uv spans the crop rect, not the tile. Undoing that here recovers a true
// 0..1 tile coordinate, which is what the distance field below needs.
// The neutral placeholder draws with gs_draw_sprite(), whose UVs already run
// 0..1, and passes (0, 0, 1, 1) — the identity — rather than a special case.
uniform float4 crop_uv;

sampler_state def_sampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertInOut {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertInOut VSDefault(VertInOut vert_in)
{
    VertInOut vert_out;
    vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = vert_in.uv;
    return vert_out;
}

// Signed distance to a rounded rectangle centred on the origin. Negative
// inside, positive outside, in the same units as `half_size`.
//
// clamp_border() (src/zoom-tile-border.h) caps the radius at half the tile's
// shorter side, which is exactly min(half_size.x, half_size.y) — so
// `half_size - r` never goes negative and the shape never inverts. The extreme
// is a capsule, which is a valid rounded rect, not a degenerate one.
float rounded_rect_sd(float2 p, float2 half_size, float r)
{
    float2 q = abs(p) - (half_size - r);
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}

float4 PSI420(VertInOut vert_in) : TARGET
{
    // ── Colour conversion. Parity-critical; independently verified. ──
    // Chroma offset is 128/255, not a flat 0.5: libobs builds its YUV matrix
    // from black_levels = {0, 128, 128} (media-io/video-matrices.c,
    // initialize_matrix), and format_conversion.effect offsets chroma by the
    // same 128/255 (~0.5019608). Using 0.5 here would leave a systematic
    // ~1-LSB tint versus the CPU path that this shader must match exactly.
    float y = image.Sample(def_sampler, vert_in.uv).r;
    float u = tex_u.Sample(def_sampler, vert_in.uv).r - 128.0 / 255.0;
    float v = tex_v.Sample(def_sampler, vert_in.uv).r - 128.0 / 255.0;

    float r = y + 1.5748 * v;
    float g = y - 0.1873 * u - 0.4681 * v;
    float b = y + 1.8556 * u;
    float3 rgb = saturate(float3(r, g, b));

    // ── Border. Deliberately downstream of, and separate from, the colour
    // maths above: it only ever reads `rgb` and never alters how it was
    // produced, so the two cannot become entangled. ──

    // Distance field in canvas pixels, so width and radius are pixel units
    // regardless of the tile's size or the feed's resolution.
    float2 tile_uv = (vert_in.uv - crop_uv.xy) / crop_uv.zw;  // 0..1 over the tile
    float2 p = (tile_uv - 0.5) * tile_size;
    float d = rounded_rect_sd(p, tile_size * 0.5, corner_radius);

    // One pixel of anti-aliasing either side of each edge. fwidth() is in
    // *screen* pixels, so this stays a single pixel wide however the operator
    // has scaled the wall in the scene. Computed outside the branches below so
    // the derivative is never taken in non-uniform control flow.
    float aa = max(fwidth(d), 0.0001);

    // Square corners: the rounded-rect mask is then the tile rect itself, which
    // the sprite already covers exactly, so the only thing the mask could do is
    // soften an edge that is not there. Forced opaque so a wall with rounded
    // corners switched off renders exactly as it did before borders existed,
    // by construction rather than by inspection.
    float alpha = 1.0;
    if (corner_radius > 0.0)
        alpha = 1.0 - smoothstep(-aa, aa, d);

    // Likewise, with no border there is nothing to stroke — and without this
    // guard a zero width would still tint the outermost pixel row towards
    // border_color, i.e. the feature would be visible while switched off.
    if (border_width > 0.0) {
        // d + border_width is the same rounded rect inset by the border, so
        // the inner corner radius follows the outer one automatically.
        float inner = 1.0 - smoothstep(-aa, aa, d + border_width);
        rgb = lerp(border_color.rgb, rgb, inner);
    }

    return float4(rgb, alpha);
}

technique I420
{
    pass
    {
        vertex_shader = VSDefault(vert_in);
        pixel_shader  = PSI420(vert_in);
    }
}

uniform float4 fill_color;

float4 PSSolid(VertInOut vert_in) : TARGET
{
    return fill_color;
}

technique Solid
{
    pass
    {
        vertex_shader = VSDefault(vert_in);
        pixel_shader  = PSSolid(vert_in);
    }
}

// ── Outer glow ───────────────────────────────────────────────────────────────
// A soft halo bleeding outward from each tile into the background.
//
// This is a SEPARATE PASS, drawn BEFORE the tiles, on a quad expanded beyond
// the tile rect — not an extension of PSI420. Two reasons, both load-bearing.
// A tile is drawn as a quad exactly its own size, so there is no canvas outside
// it for a halo to bleed into. And PSI420 carries the parity-verified BT.709
// conversion and the crop_uv correction, which are verified twice over and not
// worth disturbing for an effect that can live beside them.
//
// Draw order is: background colour -> background source -> glow -> tiles.
//
// All per-tile values, with the same upload rule as the border uniforms above:
// libobs uploads a pass's parameters inside gs_technique_begin_pass() and does
// not re-upload them per draw, so every one of these must be set BEFORE that
// tile's begin_pass. glow_begin_pass() in src/zoom-supersource.cpp is the one
// place that does it.
uniform float4 glow_color;         // halo colour; only .rgb is used
uniform float2 glow_quad_size;     // the expanded quad, in canvas pixels
uniform float2 glow_tile_center;   // the tile's centre, in quad-local pixels
uniform float2 glow_tile_half;     // half the TILE's size — not the quad's
uniform float  glow_corner_radius; // canvas pixels; matches the tile's
uniform float  glow_size;          // falloff distance in canvas pixels; > 0
uniform float  glow_intensity;     // 0..1, the alpha at the tile's own edge
// Shapes the falloff between the tile edge and the outer limit. 0..2; see the
// curve below. 0 is the default and reproduces the original (1-t)^2 exactly.
uniform float  glow_falloff;

float4 PSGlow(VertInOut vert_in) : TARGET
{
    // The glow quad is drawn with gs_draw_sprite(), whose UVs run 0..1
    // (build_sprite_norm(), libobs/graphics/graphics.c:992-1000) — so unlike
    // PSI420 there is no crop to undo here. Scaling by the quad's size gives
    // canvas pixels from its origin; subtracting the tile's centre puts the
    // origin where rounded_rect_sd() wants it.
    //
    // glow_tile_center is NOT half the quad. Once the quad is clipped by the
    // canvas edge the tile is no longer centred in it, and using the quad's
    // centre would slide every halo in the outer row and column off its tile by
    // whatever was clipped. solve_glow_quad() (src/zoom-tile-glow.h) computes
    // it, and tests/tile-glow-test.cpp pins it.
    float2 p = vert_in.uv * glow_quad_size - glow_tile_center;

    // Evaluated against the INNER tile rect: distance <= 0 is inside the tile,
    // and the halo falls off from 0 outward. Same corner radius as the tile, so
    // the halo follows a rounded tile rather than hugging a square one.
    float d = rounded_rect_sd(p, glow_tile_half, glow_corner_radius);

    // max() rather than a branch on the size: the draw path skips this pass
    // entirely at size 0, so this only keeps the divide defined.
    float t = saturate(d / max(glow_size, 0.0001));

    // (1 - t)^2 * (1 + k*t), where k = glow_falloff, 0..2.
    //
    // The (1 - t)^2 factor is what stops the halo ending on a visible band: a
    // straight ramp reaches its outer limit on a constant gradient, which reads
    // as an edge rather than as light falling off. Anything smooth multiplied
    // by (1 - t)^2 still has BOTH value and slope 0 at t = 1, so every setting
    // in range keeps that property by construction rather than by taste.
    //
    // k = 0 is the original curve, exactly — the default, so an existing scene
    // renders unchanged. k = 2 is (1-t)^2(1+2t) = 1 - smoothstep(t): flat at
    // both ends, so the halo holds its strength just outside the tile before
    // falling away through an inflection, which is how a blurred reference
    // reads next to a hard light source.
    //
    // 2 is the upper bound because it is where the family stops being monotone,
    // not because it looked far enough: d/dt = (1-t)[(k-2) - 3kt], which is <= 0
    // across [0,1) exactly when k <= 2. Above that the curve RISES just outside
    // the tile, clipping at 1 and drawing a bright ring around every tile.
    // tiles_source_update() clamps the setting; saturate() here is the shader's
    // own guard, and is exact identity on the valid domain.
    float ramp = 1.0 - t;
    float falloff = saturate(ramp * ramp * (1.0 + glow_falloff * t));

    // Straight (non-premultiplied) alpha, matching the blend factors the draw
    // path sets. glow_color.a is deliberately unused: obs_properties_add_color
    // does not expose an alpha channel, and the strength of the halo is what
    // the intensity control is for.
    return float4(glow_color.rgb, falloff * glow_intensity);
}

technique Glow
{
    pass
    {
        vertex_shader = VSDefault(vert_in);
        pixel_shader  = PSGlow(vert_in);
    }
}
