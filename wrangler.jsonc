{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "corevideo-docs",
  "main": "site-worker.js",
  "compatibility_date": "2026-05-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "corevideo.io",
      "custom_domain": true
    },
    {
      "pattern": "www.corevideo.io",
      "custom_domain": true
    },
    {
      "pattern": "corevideo.iamfatness.us/*",
      "zone_name": "iamfatness.us"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    // Run the Worker before serving static assets so host-level logic (the
    // www.corevideo.io -> apex redirect) and the security headers in
    // site-worker.js apply to every request, including asset paths.
    "run_worker_first": true
  }
}
